{
  "schema_version": 1,
  "common_checks": [
    {
      "name": "📊 Static checks / Code style, file formatting, and docs",
      "commands": [
        "bash ./misc/scripts/gitignore_check.sh",
        "prek run --from-ref <base>"
      ]
    },
    {
      "name": "CI / Select changed modules",
      "commands": [
        "python tools/ci/select_modules.py --base <base> --head <head>"
      ]
    },
    {
      "name": "CI / Modular tests",
      "commands": [
        "python tools/ci/summarize.py --selection-json <selection> --needs-json <job-results>"
      ]
    }
  ],
  "modules": [
    {
      "name": "ci",
      "paths": [
        ".github/",
        "tools/ci/"
      ],
      "runner": "ubuntu-latest",
      "handler": "generic",
      "setup_commands": [],
      "build_commands": [
        "python -m compileall -q tools/ci"
      ],
      "test_commands": [
        "python -m unittest discover -s tools/ci -p 'test_*.py' -v"
      ],
      "status_checks": [
        "Module / ci"
      ],
      "dependencies": []
    },
