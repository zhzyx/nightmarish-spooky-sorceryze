{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engine-next:scene-document:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scene_id", "scene_revision", "simulation", "entities"],
  "properties": {
    "schema_version": {"const": 1},
    "scene_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "scene_revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "simulation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixed_step_ms", "max_speed"],
      "properties": {
        "fixed_step_ms": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_speed": {"type": "number", "exclusiveMinimum": 0, "maximum": 10000}
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entity_id", "name", "node_type", "parent_entity_id", "transform", "gameplay", "assets"],
        "properties": {
          "entity_id": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "node_type": {"enum": ["Node3D", "MeshInstance3D"]},
          "parent_entity_id": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
          "transform": {
            "type": "object",
            "additionalProperties": false,
            "required": ["translation", "rotation_xyzw", "scale"],
            "properties": {
              "translation": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
              "rotation_xyzw": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
              "scale": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
            }
          },
          "gameplay": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind"],
            "properties": {"kind": {"enum": ["player_spawn", "static"]}}
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "asset_id", "revision", "content_sha256"],
              "properties": {
                "role": {"enum": ["mesh", "texture"]},
                "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
                "revision": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
                "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
