{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engine-next:ai-asset-run:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "model", "graph", "manifest", "scene_template", "asset_bindings"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "model": {"type": "object"},
    "graph": {"type": "array", "minItems": 1},
    "manifest": {"type": "object"},
    "scene_template": {"type": "object"},
    "asset_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "role", "output"],
        "properties": {
          "asset_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
          "role": {"enum": ["mesh", "texture"]},
          "output": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node", "port"],
            "properties": {
              "node": {"type": "string", "minLength": 1},
              "port": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
