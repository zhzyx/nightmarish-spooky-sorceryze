{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engine-next:render-configuration:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_package_sha256",
    "camera",
    "exposure"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "up",
        "vertical_fov_degrees",
        "near_plane",
        "far_plane"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "target": {
          "$ref": "#/$defs/vector3"
        },
        "up": {
          "$ref": "#/$defs/vector3"
        },
        "vertical_fov_degrees": {
          "type": "number",
          "minimum": 1,
          "maximum": 170
        },
        "near_plane": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100
        },
        "far_plane": {
          "type": "number",
          "exclusiveMinimum": 0.001,
          "maximum": 10000000
        }
      },
      "$comment": "Runtime validation requires far_plane greater than near_plane and nonzero camera direction and up vectors. The squared cross product of their unit vectors must exceed 1e-24."
    },
    "exposure": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 1000
    },
    "directional_light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "color",
        "illuminance"
      ],
      "properties": {
        "direction": {
          "$ref": "#/$defs/vector3"
        },
        "color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "illuminance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "$comment": "Direction specifies the world-space travel direction of light rays. It must be finite and nonzero. Omission uses the built-in directional light defaults."
    },
    "shadows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "resolution",
        "distance",
        "split_lambda",
        "depth_bias",
        "normal_bias"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resolution": {
          "type": "integer",
          "enum": [
            256,
            512,
            1024,
            2048,
            4096
          ]
        },
        "distance": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10000
        },
        "split_lambda": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "depth_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "normal_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "local_resolution": {
          "type": "integer",
          "enum": [
            256,
            512,
            1024,
            2048
          ]
        },
        "filter": {
          "enum": [
            "pcf",
            "pcss"
          ]
        },
        "light_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "$comment": "Omission uses the built-in shadow defaults. All settings remain validated when enabled is false."
    },
    "point_lights": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "color",
          "lumens",
          "range",
          "casts_shadow"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "position": {
            "$ref": "#/$defs/vector3"
          },
          "color": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "lumens": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000
          },
          "range": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10000
          },
          "casts_shadow": {
            "type": "boolean"
          }
        }
      },
      "$comment": "Omission preserves one default point light. An empty array disables point lights. IDs must be unique across point and spot lights."
    },
    "spot_lights": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "color",
          "lumens",
          "range",
          "casts_shadow",
          "direction",
          "inner_angle_degrees",
          "outer_angle_degrees"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "position": {
            "$ref": "#/$defs/vector3"
          },
          "color": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "lumens": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000
          },
          "range": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10000
          },
          "casts_shadow": {
            "type": "boolean"
          },
          "direction": {
            "$ref": "#/$defs/vector3"
          },
          "inner_angle_degrees": {
            "type": "number",
            "minimum": 0,
            "maximum": 85
          },
          "outer_angle_degrees": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 89
          }
        }
      },
      "$comment": "Omission preserves an empty array. Direction must be finite and nonzero. The outer angle must exceed the inner angle. IDs must be unique across point and spot lights."
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  },
  "$comment": "Load as strict UTF-8 JSON with duplicate keys rejected. Maximum encoded file size is 65536 bytes. The source SHA-256 must match the loaded asset package."
}
