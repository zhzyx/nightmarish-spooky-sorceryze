{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engine-next:render-configuration:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_package_sha256",
    "camera",
    "exposure"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "up",
        "vertical_fov_degrees",
        "near_plane",
        "far_plane"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "target": {
          "$ref": "#/$defs/vector3"
        },
        "up": {
          "$ref": "#/$defs/vector3"
        },
        "vertical_fov_degrees": {
          "type": "number",
          "minimum": 1,
          "maximum": 170
        },
        "near_plane": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100
        },
        "far_plane": {
          "type": "number",
          "exclusiveMinimum": 0.001,
          "maximum": 10000000
        }
      },
      "$comment": "Runtime validation requires far_plane greater than near_plane and nonzero camera direction and up vectors. The squared cross product of their unit vectors must exceed 1e-24."
    },
    "exposure": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 1000
    },
    "directional_light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "color",
        "illuminance"
      ],
      "properties": {
        "direction": {
          "$ref": "#/$defs/vector3"
        },
        "color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "illuminance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "$comment": "Direction specifies the world-space travel direction of light rays. It must be finite and nonzero. Omission uses the built-in directional light defaults."
    },
    "shadows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "resolution",
        "distance",
        "split_lambda",
        "depth_bias",
        "normal_bias"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resolution": {
          "type": "integer",
          "enum": [
            256,
            512,
            1024,
            2048,
            4096
          ]
        },
        "distance": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10000
        },
        "split_lambda": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "depth_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "normal_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "local_resolution": {
          "type": "integer",
          "enum": [
            256,
            512,
            1024,
            2048
          ]
        },
        "filter": {
          "enum": [
            "pcf",
            "pcss"
          ]
        },
        "light_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "$comment": "Omission uses the built-in shadow defaults. All settings remain validated when enabled is false."
    },
    "point_lights": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "color",
          "lumens",
          "range",
          "casts_shadow"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "position": {
            "$ref": "#/$defs/vector3"
          },
          "color": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "lumens": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000
          },
          "range": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10000
          },
          "casts_shadow": {
            "type": "boolean"
          }
        }
      },
      "$comment": "Omission preserves one default point light. An empty array disables point lights. IDs must be unique across point and spot lights."
    },
    "spot_lights": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "color",
          "lumens",
          "range",
          "casts_shadow",
          "direction",
          "inner_angle_degrees",
          "outer_angle_degrees"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "position": {
            "$ref": "#/$defs/vector3"
          },
          "color": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "lumens": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000
          },
          "range": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10000
          },
          "casts_shadow": {
            "type": "boolean"
          },
          "direction": {
            "$ref": "#/$defs/vector3"
          },
          "inner_angle_degrees": {
            "type": "number",
            "minimum": 0,
            "maximum": 85
          },
          "outer_angle_degrees": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 89
          }
        }
      },
      "$comment": "Omission preserves an empty array. Direction must be finite and nonzero. The outer angle must exceed the inner angle. IDs must be unique across point and spot lights."
    },
    "temporal_aa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "history_weight",
        "depth_threshold"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "history_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99
        },
        "depth_threshold": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 0.25
        }
      },
      "$comment": "Omission uses the built-in temporal defaults. All fields remain validated when disabled. The depth threshold is a relative depth difference."
    },
    "exposure_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "legacy",
            "manual",
            "automatic"
          ]
        },
        "manual_ev100": {
          "type": "number",
          "minimum": -16,
          "maximum": 24
        },
        "compensation_ev": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "min_ev100": {
          "type": "number",
          "minimum": -16,
          "maximum": 24
        },
        "max_ev100": {
          "type": "number",
          "minimum": -16,
          "maximum": 24
        },
        "low_percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "high_percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "light_half_life": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "dark_half_life": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "$comment": "Missing fields use defaults. Minimum EV must not exceed maximum EV and low percentile must be less than high. Legacy mode uses the numeric top-level exposure unchanged."
    },
    "bloom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 65504
        },
        "soft_knee": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mip_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      },
      "$comment": "Missing fields use defaults. Disabled bloom settings are still validated."
    },
    "light_animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loop": {
          "type": "boolean"
        },
        "interpolation": {
          "enum": [
            "linear",
            "step"
          ]
        },
        "keyframes": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seconds",
              "multiplier"
            ],
            "properties": {
              "seconds": {
                "type": "number",
                "minimum": 0
              },
              "multiplier": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      },
      "$comment": "Omitted fields use linear interpolation, no loop, and empty identity keyframes. Nonempty keys start at zero with strictly increasing seconds. Loop period is the positive final key time, and wrapping may jump. Each multiplier times base directional illuminance must remain finite and at most 1000000."
    },
    "reflections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_distance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "normal_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_steps": {
          "type": "integer",
          "minimum": 8,
          "maximum": 256
        },
        "max_roughness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "$comment": "Missing fields use disabled reflections, maximum distance 100, thickness 0.1, normal bias 0.02, 128 steps, maximum perceptual roughness 0.8. Positive GPU values must remain normal binary32. All fields are validated when disabled."
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  },
  "$comment": "Load as strict UTF-8 JSON with duplicate keys rejected. Maximum encoded file size is 65536 bytes. The source SHA-256 must match the loaded asset package."
}
