{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:engine-next:render-configuration:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_package_sha256",
    "camera",
    "exposure"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "source_package_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "position",
        "target",
        "up",
        "vertical_fov_degrees",
        "near_plane",
        "far_plane"
      ],
      "properties": {
        "position": {
          "$ref": "#/$defs/vector3"
        },
        "target": {
          "$ref": "#/$defs/vector3"
        },
        "up": {
          "$ref": "#/$defs/vector3"
        },
        "vertical_fov_degrees": {
          "type": "number",
          "minimum": 1,
          "maximum": 170
        },
        "near_plane": {
          "type": "number",
          "minimum": 0.001,
          "maximum": 100
        },
        "far_plane": {
          "type": "number",
          "exclusiveMinimum": 0.001,
          "maximum": 10000000
        }
      },
      "$comment": "Runtime validation requires far_plane greater than near_plane and nonzero camera direction and up vectors. The squared cross product of their unit vectors must exceed 1e-24."
    },
    "exposure": {
      "type": "number",
      "minimum": 0.001,
      "maximum": 1000
    },
    "directional_light": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "color",
        "illuminance"
      ],
      "properties": {
        "direction": {
          "$ref": "#/$defs/vector3"
        },
        "color": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "illuminance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "$comment": "Direction specifies the world-space travel direction of light rays. It must be finite and nonzero. Omission uses the built-in directional light defaults."
    },
    "shadows": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "resolution",
        "distance",
        "split_lambda",
        "depth_bias",
        "normal_bias"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "resolution": {
          "type": "integer",
          "enum": [
            256,
            512,
            1024,
            2048,
            4096
          ]
        },
        "distance": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10000
        },
        "split_lambda": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "depth_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.05
        },
        "normal_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "local_resolution": {
          "type": "integer",
          "enum": [
            256,
            512,
            1024,
            2048
          ]
        },
        "filter": {
          "enum": [
            "pcf",
            "pcss"
          ]
        },
        "light_radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "$comment": "Omission uses the built-in shadow defaults. All settings remain validated when enabled is false."
    },
    "point_lights": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "color",
          "lumens",
          "range",
          "casts_shadow"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "position": {
            "$ref": "#/$defs/vector3"
          },
          "color": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "lumens": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000
          },
          "range": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10000
          },
          "casts_shadow": {
            "type": "boolean"
          }
        }
      },
      "$comment": "Omission preserves one default point light. An empty array disables point lights. IDs must be unique across point and spot lights."
    },
    "spot_lights": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "position",
          "color",
          "lumens",
          "range",
          "casts_shadow",
          "direction",
          "inner_angle_degrees",
          "outer_angle_degrees"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "position": {
            "$ref": "#/$defs/vector3"
          },
          "color": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            }
          },
          "lumens": {
            "type": "number",
            "minimum": 0,
            "maximum": 100000000
          },
          "range": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10000
          },
          "casts_shadow": {
            "type": "boolean"
          },
          "direction": {
            "$ref": "#/$defs/vector3"
          },
          "inner_angle_degrees": {
            "type": "number",
            "minimum": 0,
            "maximum": 85
          },
          "outer_angle_degrees": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 89
          }
        }
      },
      "$comment": "Omission preserves an empty array. Direction must be finite and nonzero. The outer angle must exceed the inner angle. IDs must be unique across point and spot lights."
    },
    "temporal_aa": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "history_weight",
        "depth_threshold"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "history_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99
        },
        "depth_threshold": {
          "type": "number",
          "minimum": 0.0001,
          "maximum": 0.25
        }
      },
      "$comment": "Omission uses the built-in temporal defaults. All fields remain validated when disabled. The depth threshold is a relative depth difference."
    },
    "exposure_settings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "legacy",
            "manual",
            "automatic"
          ]
        },
        "manual_ev100": {
          "type": "number",
          "minimum": -16,
          "maximum": 24
        },
        "compensation_ev": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "min_ev100": {
          "type": "number",
          "minimum": -16,
          "maximum": 24
        },
        "max_ev100": {
          "type": "number",
          "minimum": -16,
          "maximum": 24
        },
        "low_percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "high_percentile": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "light_half_life": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "dark_half_life": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        }
      },
      "$comment": "Missing fields use defaults. Minimum EV must not exceed maximum EV and low percentile must be less than high. Legacy mode uses the numeric top-level exposure unchanged."
    },
    "bloom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "intensity": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 65504
        },
        "soft_knee": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mip_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        }
      },
      "$comment": "Missing fields use defaults. Disabled bloom settings are still validated."
    },
    "light_animation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "loop": {
          "type": "boolean"
        },
        "interpolation": {
          "enum": [
            "linear",
            "step"
          ]
        },
        "keyframes": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seconds",
              "multiplier"
            ],
            "properties": {
              "seconds": {
                "type": "number",
                "minimum": 0
              },
              "multiplier": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      },
      "$comment": "Omitted fields use linear interpolation, no loop, and empty identity keyframes. Nonempty keys start at zero with strictly increasing seconds. Loop period is the positive final key time, and wrapping may jump. Each multiplier times base directional illuminance must remain finite and at most 1000000."
    },
    "reflections": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "max_distance": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "thickness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "normal_bias": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_steps": {
          "type": "integer",
          "minimum": 8,
          "maximum": 256
        },
        "max_roughness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      },
      "$comment": "Missing fields use disabled reflections, maximum distance 100, thickness 0.1, normal bias 0.02, 128 steps, maximum perceptual roughness 0.8. Positive GPU values must remain normal binary32. All fields are validated when disabled."
    },
    "volumetric_fog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "distance": {
          "type": "number",
          "minimum": 1.1754943508222875e-38,
          "maximum": 10000000.0,
          "default": 100
        },
        "cell_pixels": {
          "type": "integer",
          "enum": [
            8,
            16,
            32
          ],
          "default": 16
        },
        "depth_slices": {
          "type": "integer",
          "enum": [
            32,
            64,
            96,
            128
          ],
          "default": 64
        },
        "density": {
          "type": "number",
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 1.1754943508222875e-38,
              "maximum": 65504
            }
          ],
          "default": 0.01
        },
        "height": {
          "type": "number",
          "minimum": -3.4028234663852886e+38,
          "maximum": 3.4028234663852886e+38,
          "default": 0
        },
        "height_falloff": {
          "type": "number",
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 1.1754943508222875e-38,
              "maximum": 65504
            }
          ],
          "default": 0.1
        },
        "albedo": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "default": [
            0.9,
            0.9,
            0.9
          ]
        },
        "emission": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "anyOf": [
              {
                "const": 0
              },
              {
                "minimum": 1.1754943508222875e-38,
                "maximum": 65504
              }
            ]
          },
          "default": [
            0,
            0,
            0
          ]
        },
        "phase_g": {
          "type": "number",
          "minimum": -0.95,
          "maximum": 0.95,
          "default": 0.2
        },
        "history_weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99,
          "default": 0.85
        },
        "local_volumes": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "shape": {
                "type": "string",
                "enum": [
                  "box",
                  "sphere"
                ],
                "default": "box"
              },
              "center": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": -3.4028234663852886e+38,
                  "maximum": 3.4028234663852886e+38
                },
                "default": [
                  0,
                  0,
                  0
                ]
              },
              "extent": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": 1.1754943508222875e-38,
                  "maximum": 3.4028234663852886e+38
                },
                "default": [
                  1,
                  1,
                  1
                ]
              },
              "density": {
                "type": "number",
                "anyOf": [
                  {
                    "const": 0
                  },
                  {
                    "minimum": 1.1754943508222875e-38,
                    "maximum": 65504
                  }
                ],
                "default": 0.01
              },
              "albedo": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "default": [
                  0.9,
                  0.9,
                  0.9
                ]
              },
              "emission": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number",
                  "anyOf": [
                    {
                      "const": 0
                    },
                    {
                      "minimum": 1.1754943508222875e-38,
                      "maximum": 65504
                    }
                  ]
                },
                "default": [
                  0,
                  0,
                  0
                ]
              },
              "edge_fraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 0.1
              },
              "entity_id": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807
              }
            }
          },
          "default": []
        }
      }
    },
    "particles": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "emitter_id"
        ],
        "properties": {
          "emitter_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4294967295
          },
          "entity_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9223372036854775807
          },
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "loop": {
            "type": "boolean",
            "default": true
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9223372036854775807,
            "default": 1
          },
          "rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 4096,
            "default": 16
          },
          "lifetime": {
            "type": "number",
            "minimum": 0.001,
            "maximum": 3600,
            "default": 2
          },
          "duration": {
            "type": "number",
            "minimum": 0,
            "maximum": 86400,
            "default": 1
          },
          "position": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -1000000.0,
              "maximum": 1000000.0
            },
            "default": [
              0,
              0,
              0
            ]
          },
          "position_spread": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000.0
            },
            "default": [
              0,
              0,
              0
            ]
          },
          "velocity": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": -10000.0,
              "maximum": 10000.0
            },
            "default": [
              0,
              1,
              0
            ]
          },
          "velocity_spread": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 10000.0
            },
            "default": [
              0,
              0,
              0
            ]
          },
          "start_size": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000.0,
            "default": 0.1
          },
          "end_size": {
            "type": "number",
            "minimum": 0,
            "maximum": 10000.0,
            "default": 0.1
          },
          "start_color": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "default": [
              1,
              1,
              1,
              1
            ]
          },
          "end_color": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "default": [
              1,
              1,
              1,
              0
            ]
          }
        }
      },
      "default": [],
      "description": "Emitter IDs must be unique. Runtime validation limits sum(ceil(rate*lifetime)) to 4096 for all emitters."
    },
    "material_overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "material_index"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "material_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "clearcoat": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "factor": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "roughness": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "anisotropy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "strength": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "rotation_radians": {
                "type": "number",
                "minimum": -6.283185307179586,
                "maximum": 6.283185307179586
              }
            }
          }
        }
      }
    },
    "global_illumination": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "world_bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minimum": {
              "$ref": "#/$defs/vector3"
            },
            "maximum": {
              "$ref": "#/$defs/vector3"
            }
          }
        },
        "probe_counts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 2,
            "maximum": 65536
          }
        },
        "clipmap_levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "updates_per_frame": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "rays_per_probe": {
          "type": "integer",
          "minimum": 16,
          "maximum": 1024
        },
        "trace_distance": {
          "type": "number",
          "minimum": 1.1754943508222875e-38
        },
        "hysteresis": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.99
        },
        "normal_bias": {
          "type": "number",
          "minimum": 0
        },
        "view_bias": {
          "type": "number",
          "minimum": 0
        },
        "bounce_strength": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "history_change_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_gpu_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 536870912
        }
      }
    },
    "geometry_culling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "occlusion": {
          "type": "boolean",
          "default": true
        },
        "max_commands": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295,
          "default": 262144
        }
      },
      "$comment": "The command limit controls GPU allocation planning. Capacity exhaustion selects the complete conventional draw path and is reported."
    }
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    }
  },
  "$comment": "Load as strict UTF-8 JSON with duplicate keys rejected. Maximum encoded file size is 65536 bytes. The source SHA-256 must match the loaded asset package."
}
