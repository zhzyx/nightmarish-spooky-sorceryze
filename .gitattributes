# Properly detect languages on Github
*.h linguist-language=C++
*.inc linguist-language=C++
thirdparty/* linguist-vendored

# Normalize EOL for all files that Git considers text files
* text=auto eol=lf
# Except for Windows-only / Visual Studio files
*.bat eol=crlf
*.sln eol=crlf
*.csproj eol=crlf
misc/msvs/* eol=crlf
# And some test files where the EOL matters
*.test.txt -text

# The above only works properly for Git 2.10+, so for older versions
# we need to manually list the binary files we don't want modified.
*.icns binary
*.ico binary
*.jar binary
*.png binary
*.ttf binary
*.tza binary

# GongGong workspace integration
framework/** -text whitespace=cr-at-eol
# Preserve the reviewed upstream module's trailing blank line; the frozen snapshot hook checks exact bytes.
framework/modules/sinan/refresh.mjs whitespace=cr-at-eol,-blank-at-eof
integrations/godot/*.patch -whitespace
customizations/components/issue-workorders/review.json -text whitespace=cr-at-eol
integrations/godot/verification*.json -text whitespace=cr-at-eol
distribution/notices/* -text -whitespace

# Preserve the exact host definition snapshot referenced by immutable task events.
data-collection/issue-governance-host.json -text whitespace=cr-at-eol

# Preserve immutable Issue #6 continuation evidence bytes and referenced hashes.
data-collection/issue6-continuation-*.json -text whitespace=cr-at-eol

# Preserve Issue #27 frozen-source and admission evidence exactly as observed.
data-collection/issue27-*.json -text whitespace=cr-at-eol
data-collection/issue27-previous-local-admission/*.json -text whitespace=cr-at-eol

# Preserve Issue #35 frozen source, review history, and evidence bytes.
data-collection/issue35-*.json -text whitespace=cr-at-eol
data-collection/issue35-previous-local-admission/** -text whitespace=cr-at-eol

archive/olympus-retired-20261104/** -text -whitespace

# Preserve bytes of the exact Yanluo v0.1.2 candidate approved by the user.
customizations/components/yanluo/component.json -text whitespace=cr-at-eol
customizations/components/yanluo/reporting.json -text whitespace=cr-at-eol
