static func install() -> void:
	var domain := TranslationServer.get_or_add_domain(DOMAIN)
	var english := Translation.new()
	english.locale = "en"
	var chinese := Translation.new()
	chinese.locale = "zh"
	for message in ENGLISH:
		english.add_message(message, ENGLISH[message])
		chinese.add_message(message, message)
		# Explicitly translated labels can survive a locale change without rebuilding inputs.
		english.add_message(ENGLISH[message], ENGLISH[message])
		chinese.add_message(ENGLISH[message], message)
	domain.add_translation(english)
	domain.add_translation(chinese)


static func configure(language: String) -> void:
	TranslationServer.get_or_add_domain(DOMAIN).set_locale_override("en" if language == "en" else "zh")
