  "governance_policy": {
    "root": "zeus",
    "applies_to": "all_current_and_future_agents",
    "required": true,
    "optional": false,
    "exemptions": [],
    "includes": [
      "governance",
      "management",
      "scheduling",
      "design",
      "production",
      "review",
      "temporary",
      "derived",
      "external",
      "third_party_wrapped",
      "resumed",
      "migrated"
