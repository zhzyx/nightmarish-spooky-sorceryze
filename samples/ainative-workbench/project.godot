config_version=5
[application]
config/name="AINative Local Copy Workbench"
run/main_scene="res://main.tscn"
[display]
window/size/viewport_width=1200
window/size/viewport_height=800
[rendering]
renderer/rendering_method="gl_compatibility"
[editor_plugins]
enabled=PackedStringArray("res://addons/ainative/plugin.cfg")
