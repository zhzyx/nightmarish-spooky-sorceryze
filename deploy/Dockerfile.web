# Tianxuan Next.js web shell (self-hosted).
#
# BUILD CONTEXT IS `apps/tianxuan` (the directory containing package.json and
# package-lock.json). Compose configures this automatically:
#   context: ../apps/tianxuan
#   dockerfile: ../../deploy/Dockerfile.web
#
# Build directly, from apps/tianxuan:
#   docker build -f ../../deploy/Dockerfile.web -t tianxuan-web .

# ---- dependencies (full install, needed for the TypeScript/Next build) ----
FROM node:22-alpine AS deps
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci

# ---- build ----
FROM node:22-alpine AS builder
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_* variables are inlined into the browser bundle at build time,
# so they are build args rather than runtime environment variables.
# An empty API base means "same origin": the browser calls /api/v1/... and the
# bundled nginx proxy forwards /api/ to the api service.
ARG NEXT_PUBLIC_TIANXUAN_API_BASE=
ARG NEXT_PUBLIC_TIANXUAN_ACTOR=
ENV NEXT_PUBLIC_TIANXUAN_API_BASE="${NEXT_PUBLIC_TIANXUAN_API_BASE}" \
    NEXT_PUBLIC_TIANXUAN_ACTOR="${NEXT_PUBLIC_TIANXUAN_ACTOR}"

# Copy only build inputs, not the whole context: a developer's local
# node_modules/.next (git-ignored but present on disk) must never overwrite the
# Linux dependencies installed above. If the app gains a `public/` directory,
# add a corresponding COPY line here.
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY tsconfig.json next-env.d.ts next.config.mjs ./
COPY app ./app
COPY components ./components
COPY lib ./lib
RUN npm run build

# ---- production dependencies only ----
FROM node:22-alpine AS prod-deps
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev

# ---- runtime ----
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# The official Node image ships an unprivileged `node` user (uid 1000).
COPY --from=prod-deps --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/.next ./.next
COPY --from=builder --chown=node:node /app/next.config.mjs ./next.config.mjs
COPY --from=builder --chown=node:node /app/package.json ./package.json

USER node

EXPOSE 3000

CMD ["npm", "run", "start"]
