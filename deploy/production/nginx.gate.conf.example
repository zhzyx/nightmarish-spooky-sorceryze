# Tianxuan production nginx: TLS + per-user key authentication.
# Replace __TIANXUAN_HOST__ before use; keys remain in the application store.
# Mounted read-only at /etc/nginx/nginx.conf.

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;

    client_max_body_size 25m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json
               application/javascript application/xml image/svg+xml;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    resolver 127.0.0.11 valid=10s ipv6=off;

    # HTTP: ACME challenges and a permanent redirect to the TLS host.
    server {
        listen 80;
        server_name _;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
            allow all;
        }

        location / {
            return 301 https://__TIANXUAN_HOST__$request_uri;
        }
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name __TIANXUAN_HOST__;

        ssl_certificate /etc/letsencrypt/live/__TIANXUAN_HOST__/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/__TIANXUAN_HOST__/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;

        location = /gate { return 410; }
        location = /login.html { return 302 /login; }

        location = /_account_auth {
            internal;
            set $auth_backend http://api:8000;
            proxy_pass $auth_backend/api/v1/auth/me;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Cookie $http_cookie;
            proxy_set_header Authorization $http_authorization;
        }

        location @key_login { return 302 /login; }

        location = /login {
            set $login_web http://web:3000;
            proxy_pass $login_web;
            proxy_set_header Host $host;
        }

        location /_next/static/ {
            set $static_web http://web:3000;
            proxy_pass $static_web;
            proxy_set_header Host $host;
        }

        location /api/v1/ws/ {
            set $api_ws http://api:8000;
            proxy_pass $api_ws;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            proxy_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location /api/ {
            set $api_http http://api:8000;
            proxy_pass $api_http;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
        }

        # Context RPC authenticates the admitted execution token in the API;
        # it is not a browser account/cookie request.
        location /native-context/ {
            set $native_context_http http://api:8000;
            proxy_pass $native_context_http;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            client_max_body_size 256k;
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 40s;
            proxy_send_timeout 40s;
        }

        location / {
            auth_request /_account_auth;
            error_page 401 = @key_login;
            set $web_http http://web:3000;
            proxy_pass $web_http;

            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            proxy_read_timeout 60s;
        }
    }
}
