# Tianxuan production nginx: TLS + ACME + cookie access gate.
# Replace __TIANXUAN_HOST__ and __ACCESS_TOKEN__ before use.
# Mounted read-only at /etc/nginx/nginx.conf.

user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for"';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    keepalive_timeout 65;
    server_tokens off;

    client_max_body_size 25m;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml application/json
               application/javascript application/xml image/svg+xml;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ""      close;
    }

    map $http_x_forwarded_proto $forwarded_proto {
        default $http_x_forwarded_proto;
        ""      $scheme;
    }

    map $arg_key $gate_cookie {
        default "";
        "__ACCESS_TOKEN__" "tx_access=__ACCESS_TOKEN__; Path=/; Max-Age=2592000; Secure; HttpOnly; SameSite=Lax";
    }

    # Internal SSR traffic (Docker network / loopback) bypasses the cookie gate.
    geo $tx_internal {
        default 0;
        127.0.0.1 1;
        172.16.0.0/12 1;
    }

    map $cookie_tx_access $tx_cookie_ok {
        default 0;
        "__ACCESS_TOKEN__" 1;
    }

    map "$tx_internal$tx_cookie_ok" $tx_allowed {
        default 0;
        "11" 1;
        "10" 1;
        "01" 1;
    }

    resolver 127.0.0.11 valid=10s ipv6=off;

    # HTTP: ACME challenges and a permanent redirect to the TLS host.
    server {
        listen 80;
        server_name _;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
            allow all;
        }

        location / {
            return 301 https://__TIANXUAN_HOST__$request_uri;
        }
    }

    server {
        listen 443 ssl;
        http2 on;
        server_name __TIANXUAN_HOST__;

        ssl_certificate /etc/letsencrypt/live/__TIANXUAN_HOST__/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/__TIANXUAN_HOST__/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:SSL:10m;
        ssl_session_timeout 1d;

        add_header Strict-Transport-Security "max-age=31536000" always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options SAMEORIGIN always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;

        # One-time link: set the cookie and redirect to the app.
        location = /gate {
            add_header Set-Cookie $gate_cookie;
            if ($arg_key != "__ACCESS_TOKEN__") {
                return 403;
            }
            return 302 /;
        }

        location = /login.html {
            root /usr/share/nginx/html;
        }

        location /api/v1/ws/ {
            if ($tx_allowed = 0) {
                return 401;
            }
            set $api_ws http://api:8000;
            proxy_pass $api_ws;

            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            proxy_buffering off;
            proxy_read_timeout 3600s;
            proxy_send_timeout 3600s;
        }

        location /api/ {
            if ($tx_allowed = 0) {
                return 401;
            }
            set $api_http http://api:8000;
            proxy_pass $api_http;

            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            proxy_read_timeout 120s;
            proxy_send_timeout 120s;
        }

        location / {
            if ($tx_allowed = 0) {
                return 302 /login.html;
            }
            set $web_http http://web:3000;
            proxy_pass $web_http;

            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Port $server_port;

            proxy_read_timeout 60s;
        }
    }
}
