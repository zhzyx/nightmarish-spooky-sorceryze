# Tianxuan self-hosted deployment configuration.
#
# Copy this file to .env and edit it, then run from deploy/:
#   cp .env.example .env
#   docker compose --env-file .env up -d --build
#
# deploy/.env is git-ignored; never commit real credentials.
# The values below are safe defaults/examples only.

# ---------------------------------------------------------------------------
# Compose / entry point
# ---------------------------------------------------------------------------

# Host port for the bundled nginx proxy. Reach the stack at
# http://<host>:${TIANXUAN_HTTP_PORT}/
TIANXUAN_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# API (container paths)
# ---------------------------------------------------------------------------

# SQLite database file. Keep it under /data so the named volume persists it.
TIANXUAN_DB=/data/tianxuan.db

# Directory holding the bare Git repositories used by requirement commits. It
# must already contain the repositories the UI selects; the API does not clone
# or create them on demand.
TIANXUAN_REPO_ROOT=/data/repos

# ---------------------------------------------------------------------------
# API: external Gitea/Forgejo (optional)
# ---------------------------------------------------------------------------
# Leave URL and token empty to disable the Gitea-backed repository views.
# The token needs repository read/write scope; it is stored only in .env.
TIANXUAN_GITEA_URL=
TIANXUAN_GITEA_TOKEN=
# Default repository owner; optional.
TIANXUAN_GITEA_OWNER=

# ---------------------------------------------------------------------------
# Web
# ---------------------------------------------------------------------------

# Browser-facing API origin baked into the Next.js bundle at build time.
# Recommended: empty, so the browser uses the same origin and nginx forwards
# /api/ to the api service. If you set an absolute URL, that origin must serve
# the API itself: FastAPI has no CORS middleware, so cross-origin calls fail.
NEXT_PUBLIC_TIANXUAN_API_BASE=

# Browser-side actor (registered user id) used by the editor to save documents.
# This is baked in at build time; changing it requires rebuilding the web image.
NEXT_PUBLIC_TIANXUAN_ACTOR=

# Server-side actor (registered user id) for the live panels on /docs and
# /repos. This only helps together with an absolute
# NEXT_PUBLIC_TIANXUAN_API_BASE that the web container can also reach: Next
# server components cannot fetch a relative URL. With the recommended empty
# (same-origin) base those panels keep their demo data.
TIANXUAN_ACTOR=
