# Tianxuan FastAPI service (self-hosted).
#
# BUILD CONTEXT MUST BE THE REPOSITORY ROOT.
# The server imports its sibling modules (`wenqu`, `duobao`) through the
# bridge modules inside `server/`, so those directories must be present in the
# image with their repository-relative layout preserved.
#
# Build directly, from the repository root:
#   docker build -f deploy/Dockerfile.api -t tianxuan-api .
#
# Or through Compose, from the `deploy/` directory:
#   docker compose --env-file .env build api

FROM node:22-bookworm-slim AS native-node

FROM python:3.12-slim

# `PYTHONPATH` points at the three import roots:
#   server/ -> api, main, schemas, tianxuan_core, gateway, *_bridge
#   wenqu/  -> wenqu
#   duobao/ -> git_service, gitea_client
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/customizations/components/tianxuan/server:/app/customizations/components/tianxuan/wenqu:/app/customizations/components/tianxuan/duobao:/app/customizations/components/tianxuan/sinan-workorders \
    TIANXUAN_DB=/data/tianxuan.db \
    TIANXUAN_REPO_ROOT=/data/repos

# The duobao GitService shells out to the system `git` CLI; ca-certificates is
# needed for HTTPS calls to an external Gitea/Forgejo.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# Fixed uid/gid so a bind-mounted /data directory can be prepared on the host
# with: chown -R 10001:10001 <host-dir>
RUN groupadd --gid 10001 tianxuan \
    && useradd --uid 10001 --gid tianxuan --create-home --shell /usr/sbin/nologin tianxuan

WORKDIR /app

# Business source changes reuse the dependency layer.
COPY customizations/components/tianxuan/server/requirements.txt /app/customizations/components/tianxuan/server/requirements.txt
RUN python -m pip install --no-cache-dir \
        -r /app/customizations/components/tianxuan/server/requirements.txt

# Keep the repository layout intact: the bridge modules resolve their siblings
# with Path(__file__).resolve().parents[1] / "wenqu" and "duobao".
COPY customizations/components/tianxuan/server/ /app/customizations/components/tianxuan/server/
COPY customizations/components/tianxuan/wenqu/ /app/customizations/components/tianxuan/wenqu/
COPY customizations/components/tianxuan/duobao/ /app/customizations/components/tianxuan/duobao/
COPY customizations/components/tianxuan/sinan-workorders/ /app/customizations/components/tianxuan/sinan-workorders/
COPY customizations/platforms/ai-access/host-http/runtime/ /app/customizations/platforms/ai-access/host-http/runtime/
COPY customizations/platforms/process-management/yuanheng-local/sinan/dispatch.mjs /app/customizations/platforms/process-management/yuanheng-local/sinan/dispatch.mjs
COPY framework/ /app/framework/
COPY tools/ainative/owned_process.py /app/tools/ainative/owned_process.py
COPY tools/codex_cli/subscription_session.js tools/codex_cli/content_preview.js tools/codex_cli/subscription_profile.py /app/tools/codex_cli/
# The Debian Node executable matches the glibc host; do not copy the Alpine web
# executable or bring npm, model credentials, or provider installations here.
COPY --from=native-node /usr/local/bin/node /usr/local/bin/node

# Validate the installed dependency closure without opening databases, starting
# the web app, signing tasks, or invoking a model during image construction.
RUN node --version \
    && node -e "require('/app/tools/codex_cli/subscription_session.js')" \
    && python -c "import native_entry_factory, native_context, native_node; from native_entry_runtime import runner; runner.runtime_digest()"

# Persistent state lives on one volume: SQLite database + optional local Git
# repositories used by requirement commits. A freshly created named volume
# inherits this ownership from the image.
RUN mkdir -p /data/repos \
    && chown -R tianxuan:tianxuan /data

USER tianxuan

WORKDIR /app/customizations/components/tianxuan/server

EXPOSE 8000

# Deliberately a single uvicorn worker:
#   - WebSocket document rooms are kept in process memory, so multiple workers
#     would not see each other's subscribers;
#   - the SQLite deployment is single-writer.
# Put more API capacity behind a real database first; see deploy/README.md.
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips=*"]
