+"""Deterministic, complete Gonggong -> Olympus distribution rebuild and drift check."""
+from pathlib import Path, PureWindowsPath
+import argparse,ast,hashlib,json,os,subprocess,sys
+ADAPTERS=['sync/gonggong_sync.py','sync/read_hermes.py','sync/POLICY.md','sync/names.json','sync/sinan_source.py','sync/local_runtime.py']
+REPORTS={'sync/verification.json'}
+EXEMPT='extensions/hermes-files/'
+def adapters_at(root):
+    result={p:(root/p).read_bytes() for p in ADAPTERS}
+    extension=inventory(root/EXEMPT)
+    if not {'README.md','hermes_files.py','event.schema.json'}<=extension.keys():raise ValueError('Independent Hermes file module missing')
+    result.update({EXEMPT+p:b for p,b in extension.items()})
+    return result
+def encoded(v):return (json.dumps(v,ensure_ascii=False,indent=2)+'\n').encode()
+def sha(b):return hashlib.sha256(b).hexdigest()
+
+def locations(root, binding):
+    """Locators are relative to this framework, never the caller's working directory."""
+    if any(Path(v).is_absolute() or PureWindowsPath(v).drive for v in binding.values()):
+        raise ValueError('Committed upstream bindings must be relative paths')
+    return {k:str((root/v).resolve()) for k,v in binding.items()}
+
+def verify_source(src,candidate=False):
+    r=subprocess.run([sys.executable,str(src/'tools/verify_framework.py')]+(['--candidate'] if candidate else []),capture_output=True,text=True,encoding='utf-8',
+                     env=dict(os.environ,PYTHONDONTWRITEBYTECODE='1',PYTHONUTF8='1',PYTHONIOENCODING='utf-8'))
+    if r.returncode:raise ValueError('Upstream integrity/admission rejected: '+r.stderr)
+
+def admitted_overlays(root,wanted,actual):
