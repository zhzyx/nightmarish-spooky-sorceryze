{
  "schema_version": 1,
  "name": "GongGong",
  "path_base": "this_file_directory",
  "repository": "https://github.com/zhzyx/nightmarish-spooky-sorceryze",
  "framework_pointer": "CURRENT_FRAMEWORK.json",
  "framework_root": "framework",
  "data_root": "gonggong-diting-data",
