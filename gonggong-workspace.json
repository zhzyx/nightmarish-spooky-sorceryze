    "olympus-hermes-data"
  ],
  "data_module": "framework/extensions/diting-files",
  "data_artifacts_required_in_git": true,
  "runtime_entry": "tools/gonggong_bridge.py",
  "editor_launch": "tools/launch_gonggong_editor.ps1",
  "integration_components": [
    "customizations/components/issue-workorders",
    "customizations/components/godot-host"
  ],
  "admission_state": "candidate_pending_exact_review",
  "integration_submodules": [
    {
      "id": "git",
      "name": "Git 接入",
      "components": [
        "issue-workorders",
        "git-issue"
      ],
      "migration": "customizations/module-migration.json"
    },
    {
      "id": "godot",
      "name": "Godot 接入",
      "components": [
        "godot-host"
      ],
      "migration": "customizations/module-migration.json"
    },
    {
      "id": "diting-file-data",
      "name": "谛听文件采集",
      "components": [
        "diting-file-data"
      ],
      "migration": "customizations/module-migration.json"
    }
  ],
  "platform_catalog": "customizations/platforms/catalog.json"
}
