      "id": "parameter_storage_loses_extension_routing",
      "original_candidate": "R3",
      "description": "RGBA16F material storage rounded legal tiny extension strengths to zero while forward constants retained them.",
      "resolution": "R4 changes the parameter target, SRV and RTV6 to RGBA32F. Tangent storage remains RGBA16F.",
      "actual_validation": {
        "path": "build/engine_next/material-capture-r4-live/NumericalChecks.json",
        "size_bytes": 51735,
        "sha256": "69652f69ba71de6764bbf2458b861755c535a7c7d2c9a955c1630350de69aac9"
      },
      "reviewer_numeric_check": "The recorded R4 tiny-case opaque constant vectors exactly equal stored parameter vectors; R3 records retain their zeroed half values."
    },
    {
      "id": "default_transparency_loads_extended_shader",
      "original_candidate": "R3",
      "description": "The default path selected the transparent shader containing dynamic extended-material sampling code. A long cold initialization was observed, while its exact driver phase remained unknown.",
      "resolution": "R4 introduces a separate MaterialTransparent pixel shader and preprocessor-gates extended direct/IBL calls. Default and explicit-zero scenes use the legacy transparency shader.",
      "actual_validation": {
        "default_report": {
          "path": "build/engine_next/material-gpu-r4/Default.json",
