    "python_source": [
      "import json, sys, tempfile",
      "from pathlib import Path",
      "sys.path.insert(0, str(Path(\"tools/ainative\").resolve()))",
      "from kimi_work_image_provider import KimiWorkImageProvider",
      "from kimi_provider import KimiNativeDirectProvider",
      "for cls in (KimiWorkImageProvider, KimiNativeDirectProvider):",
      "    for delay in (0, 0.25):",
      "        for deadline in (0.15, 3):",
      "            for expected in (0, 7):",
      "                with tempfile.TemporaryDirectory() as folder:",
      "                    root = Path(folder)",
      "                    (root / \"runtime\").mkdir()",
      "                    adapter = cls.__new__(cls)",
      "                    reasons = []",
      "                    adapter._active = lambda *_: True",
      "                    adapter.finish = lambda key, state, reason: reasons.append(reason)",
      "                    code = \"pass\" if expected == 0 else \"raise SystemExit(7)\"",
      "                    if delay:",
      "                        code = f\"import time; time.sleep({delay}); \" + code",
      "                    observed = adapter._run_owned(\"fixture\", [sys.executable, \"-c\", code], \"watch.log\", \"image_generation\", deadline, root)",
      "                    print(json.dumps(dict(provider=cls.__name__, delay_s=delay, deadline_s=deadline, requested_exit=expected, adapter_result=observed, failure_reasons=reasons)))"
    ]
