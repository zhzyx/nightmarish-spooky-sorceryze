    "proposal": {
      "request_id": "native-model-live-capability-1480-v1",
      "input_digest": "82efe197c346b10f9a64af05198c97714d34fdf2b1ccc267ecd048964f1a3ae4",
      "summary": "Proposes a pure function that validates inputs, applies changes without mutation, and returns sorted keys.",
      "files": [
        {
          "path": "module_map.py",
          "content": "import re\n\n\ndef select_versions(base, changes):\n    \"\"\"Return a sorted module mapping without modifying either input.\n\n    Raise ValueError for invalid mappings, IDs, revisions, or removals.\n    \"\"\"\n    if not isinstance(base, dict) or not isinstance(changes, dict):\n        raise ValueError(\"base and changes must be dictionaries\")\n\n    def validate_id(module_id):\n        if not isinstance(module_id, str) or re.fullmatch(\n            r\"[a-z][a-z0-9_]*\", module_id\n        ) is None:\n            raise ValueError(\"Invalid module ID\")\n\n    def validate_revision(revision):\n        if not isinstance(revision, str) or re.fullmatch(\n            r\"[0-9a-f]{64}\", revision\n        ) is None:\n            raise ValueError(\"Invalid revision digest\")\n\n    result = {}\n    for module_id, revision in base.items():\n        validate_id(module_id)\n        validate_revision(revision)\n        result[module_id] = revision\n\n    for module_id, revision in changes.items():\n        validate_id(module_id)\n        if revision is None:\n            if module_id not in result:\n                raise ValueError(\"Cannot remove an unknown module\")\n            del result[module_id]\n        else:\n            validate_revision(revision)\n            result[module_id] = revision\n\n    return {module_id: result[module_id] for module_id in sorted(result)}\n"
        }
      ]
    },
