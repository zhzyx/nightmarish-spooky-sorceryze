  "hook_probe_source": "import json\nimport sys\nfrom pathlib import Path\n\n# Reviewed isolated capability probe, never a production authority or acceptance source.\nroot = Path(__file__).resolve().parent\n\ndef read(name, limit):\n    path = root / name\n    if path.is_symlink():\n        raise ValueError('symlink rejected')\n    if not path.exists():\n        return None\n    if not path.is_file() or path.stat().st_size > limit:\n        raise ValueError('invalid bounded file')\n    return path.read_text()\n\ntry:\n    event = json.loads(sys.stdin.read(65537))\n    result = {}\n    if event.get('hook_event_name') == 'Stop':\n        value = read('hook-invocations.json', 16)\n        count = json.loads(value) if value is not None else 0\n        if type(count) is not int or not 0 <= count <= 100:\n            raise ValueError('invalid count')\n        valid = lambda name: (read(name, 64) or '').strip() == 'verified'\n        if valid('stage1.txt') and not valid('stage2.txt') and count < 2:\n            result = {'decision': 'block', 'reason': '本隔离测试整体授权目标仍有第二阶段：在当前目录写 stage2.txt，内容为 verified，再实际读取两个阶段文件核验。请立即完成，不要再次确认；不要修改 hook 文件或计数器，不操作其他目录。'}\n        (root / 'hook-invocations.json').write_text(json.dumps(count + 1))\n        audit = root / ('hook-event-' + str(count) + '.json')\n        # Never replace prior evidence or follow a model-created link.\n        with audit.open('x') as stream:\n            json.dump({'hook_event_name': event.get('hook_event_name'), 'turn_id': event.get('turn_id'), 'stop_hook_active': event.get('stop_hook_active'), 'output': result}, stream, ensure_ascii=False)\n    print(json.dumps(result, ensure_ascii=False))\nexcept (OSError, ValueError, TypeError):\n    print('{}')\n",
