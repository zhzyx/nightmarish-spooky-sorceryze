{
  "package": "gonggong-framework-design",
  "version": "0.9.2",
  "status": "candidate_pending_review",
  "host_loader_implemented": true,
  "discovery_index": "README.md",
  "foundation": "FOUNDATION.md",
  "governance": "GOVERNANCE.md",
  "planned_default_instruction_sources": [
    "upstream/yuanheng/core.md",
    "upstream/yuanheng/agents/yuanheng.md",
    "FOUNDATION.md",
    "<host-issued-task-mandate>"
  ],
  "on_demand_organization": "upstream/yuanheng/skills/yuanheng-organize/SKILL.md",
  "specifications": [
    {
      "path": "specs/module-system.md",
      "title": "共工模块系统规范",
      "load_when": "评估、开发或组合生产模块时",
      "conditional_references": [
        "GOVERNANCE.md"
      ]
    },
    {
      "path": "specs/customer-solution.md",
      "title": "共工客户评估与方案配置规范",
      "load_when": "客户接入、试产或调整方案时",
      "conditional_references": [
        "specs/module-system.md"
      ]
    },
    {
      "path": "specs/agent-organization.md",
      "title": "共工 Agent 动态组织规范",
      "load_when": "分配职责、调整分工或沉淀方法时",
      "conditional_references": [
        "GOVERNANCE.md"
      ]
    },
    {
      "path": "specs/project-state.md",
      "title": "共工项目状态与记录规范",
      "load_when": "实现状态、工单、证据和上下文恢复时",
      "conditional_references": [
        "GOVERNANCE.md"
      ]
    },
    {
      "path": "specs/concurrency.md",
      "title": "共工并发生产与集成规范",
      "load_when": "调度或集成并发工程变更时",
      "conditional_references": [
        "specs/project-state.md"
      ]
    },
    {
      "path": "specs/code-collaboration.md",
      "title": "共工代码与业务协同规范",
      "load_when": "变更代码、接口、数据或业务规则时",
      "conditional_references": [
        "specs/concurrency.md"
      ]
    },
    {
      "path": "specs/scene-collaboration.md",
      "title": "共工场景与资产协同规范",
      "load_when": "变更场景对象、共享资产或派生资源时",
      "conditional_references": [
        "specs/concurrency.md"
      ]
    },
    {
      "path": "specs/quality.md",
      "title": "共工过程与结果质量规范",
      "load_when": "配置或执行适用质量验证时",
      "conditional_references": [
        "specs/project-state.md"
      ]
    },
    {
      "path": "specs/engine-adapter.md",
      "title": "共工引擎适配与迁移规范",
      "load_when": "接入 Godot 或迁移自研引擎时",
      "conditional_references": [
        "specs/module-system.md"
      ]
    },
    {
      "path": "specs/enterprise-operations.md",
      "title": "共工企业接入与运行规范",
      "load_when": "接入企业系统、部署或管理容量时",
      "conditional_references": [
        "specs/customer-solution.md"
      ]
    },
    {
      "path": "specs/governance-review.md",
      "title": "共工回查校验与外部 Agent 准入规范",
      "load_when": "共工生产、skill 与 Agent 创建变更、外部 Agent 合入时",
      "conditional_references": [
        "GOVERNANCE.md"
      ]
    },
    {
      "path": "specs/document-design.md",
      "title": "共工文档设计单元",
      "load_when": "偃师独立 Agent 接入、需求理解与设计交接时",
      "conditional_references": [
        "specs/agent-organization.md"
      ]
    },
    {
      "path": "specs/quality-responsibilities.md",
      "title": "共工质量职责与夸父接入规范",
      "load_when": "分配质量职责、处理跨业务质量事件或接入夸父时",
      "conditional_references": [
        "specs/quality.md"
      ]
    },
    {
      "path": "specs/data-feedback.md",
      "title": "共工数据与反馈模块",
      "load_when": "接入外部数据、分析用户反馈或提出通用 Agent 优化时",
      "conditional_references": [
        "specs/enterprise-operations.md",
        "specs/project-state.md"
      ]
    },
    {
      "path": "specs/reporting.md",
      "title": "共工组件默认谛听上报",
      "load_when": "创建、变更、合入或启用 skill 与 Agent 时",
      "conditional_references": [
        "specs/governance-review.md"
      ]
    },
    {
      "path": "specs/model-runtime.md",
      "title": "跨模型运行与能力准入",
      "load_when": "模型接入、任务执行和能力评测时",
      "conditional_references": [
        "specs/reporting.md"
      ]
    },
    {
      "path": "specs/work-order-management.md",
      "title": "司南全任务工单管理与协调",
      "load_when": "需求、工单进度、依赖、决策或执行回执变化，以及用户主动查询时",
      "conditional_references": [
        "specs/project-state.md",
        "specs/reporting.md"
      ]
    },
    {
      "path": "specs/delivery.md",
      "title": "共工交付与版本核验",
      "load_when": "版本库合入、发布、可运行交付或共享依赖变更时",
      "conditional_references": [
        "specs/code-collaboration.md",
        "specs/work-order-management.md"
      ]
    },
    {
      "path": "specs/core-agent-adaptation.md",
      "title": "核心 Agent 与接入适配",
      "load_when": "调整核心职责与接入边界时"
    }
  ],
  "never_bulk_load": [
    "specs",
    "references",
    "upstream/yuanheng/contracts"
  ],
